# Environment: staging
# Committed on purpose: secrets in here are enc1.… tokens, decryptable only with
# $STRING_HEX_DEMOBLAZE. Machine-local overrides go in env/.env.staging.local (gitignored).
# DemoBlaze has a single public deployment, so both environments point at it.

BASE_URL=https://www.demoblaze.com
API_URL=https://api.demoblaze.com

# Accounts logged in by global setup before the run (comma-separated Account values)
PRELOGIN_ACCOUNTS=admin

