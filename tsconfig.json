{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["bun", "node"],
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "paths": {
      "@api": ["./src/api/index.ts"],
      "@api/*": ["./src/api/*"],
      "@auth/*": ["./src/auth/*"],
      "@components/*": ["./src/components/*"],
      "@config/*": ["./src/config/*"],
      "@data/*": ["./src/data/*"],
      "@fixtures": ["./src/fixtures/index.ts"],
      "@k6/*": ["./k6/*"],
      "@pages/*": ["./src/pages/*"],
      "@perf/*": ["./src/perf/*"],
      "@utils/*": ["./src/utils/*"]
    },

    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "tests", "scripts", "playwright.config.ts", "eslint.config.ts"]
}
