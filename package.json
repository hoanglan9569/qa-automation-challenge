{
  "name": "qa-automation-challenge",
  "description": "Playwright + k6 test automation for DemoBlaze (S5Tech QA Automation Challenge)",
  "author": "Lan Hoang <hoanglan9569@gmail.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "setup": "bun install --frozen-lockfile && bun run browsers",
    "test": "bun --bun playwright test --project=api --project=chromium",
    "test:all": "bun --bun playwright test --project=api --project=chromium --project=firefox --project=webkit --project=mobile-chrome --project=mobile-safari",
    "test:smoke": "bun --bun playwright test --project=api --project=chromium --grep @smoke",
    "test:regression": "bun --bun playwright test --project=api --project=chromium --grep @regression",
    "test:mobile": "bun --bun playwright test --project=mobile-chrome --project=mobile-safari",
    "test:branded": "bun --bun playwright test --project=chrome --project=edge",
    "perf": "bun --bun playwright test --project=perf --workers=1",
    "perf:load": "PERF_PROFILE=load bun --bun playwright test --project=perf --workers=1",
    "k6:install": "bun run scripts/install-k6.ts",
    "test:staging": "TEST_ENV=staging bun --bun playwright test --project=api --project=chromium",
    "test:production": "TEST_ENV=production bun --bun playwright test --project=api --project=chromium",
    "report": "bun --bun playwright show-report",
    "browsers": "PLAYWRIGHT_BROWSERS_PATH=.tools/ms-playwright playwright install --with-deps chromium firefox webkit",
    "crypto": "bun run scripts/crypto.ts",
    "tsc": "bun node_modules/typescript-7/bin/tsc",
    "typecheck": "bun run tsc --noEmit && bun run tsc --noEmit -p k6",
    "lint": "bun --bun eslint .",
    "lint:fix": "bun --bun eslint . --fix",
    "format": "bun --bun prettier . --write",
    "format:check": "bun --bun prettier . --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.0",
    "@types/bun": "^1.4.2",
    "@types/k6": "^2.3.0",
    "@types/node": "^26.6.5",
    "arktype": "^2.2.8",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.71.1"
  }
}
